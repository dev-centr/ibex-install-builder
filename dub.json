{
	"name": "ibex",
	"description": "Ibex (Install Builder EXtension) — author installer packages and put tools on PATH.",
	"homepage": "https://github.com/dev-centr/ibex-install-builder",
	"authors": ["DevCentr"],
	"license": "MIT",
	"targetType": "executable",
	"targetName": "ibex",
	"sourcePaths": ["source", "plugins"],
	"importPaths": ["source", "plugins"],
	"versions": ["EasyInstallerBuiltinPlugins"],
	"configurations": [
		{
			"name": "application",
			"targetType": "executable",
			"mainSourceFile": "source/app.d"
		},
		{
			"name": "library",
			"targetType": "library",
			"excludedSourceFiles": ["source/app.d"]
		}
	]
}
